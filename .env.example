# LLM2Decision environment variables — OPTIONAL. Skip this file unless you specifically want it.
#
# The main config is llm2decision.yaml (template: llm2decision.yaml.example). That is the file you
# copy and fill in for a normal setup, and it is where every option lives. This file exists only for
# container/CI setups that prefer to inject the key via the environment instead of writing a file.
# You never need both, and you never copy this file for a normal setup.
#
# THIS FILE IS COMMITTED TO A PUBLIC REPO. Leave values empty or use placeholders.
# Never paste a real key here; real keys belong in .env / .env.local (both gitignored).
#
# Precedence: route config > defaults section > environment > built-in default.
# A value written in llm2decision.yaml is never overridden by an environment variable, so
# these are a fallback. Supplying only these (with no config file) synthesises a single
# route named `default`; LLM2DECISION_MODEL is then required, or startup fails.

# Path to the config file (defaults to ./llm2decision.yaml)
LLM2DECISION_CONFIG=

# --- single-route mode ---------------------------------------------------------------
LLM2DECISION_PROVIDER=ark
LLM2DECISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM2DECISION_API_KEY=
LLM2DECISION_MODEL=
LLM2DECISION_TOP_LOGPROBS=20
LLM2DECISION_TEMPERATURE_SCALE=1.0
LLM2DECISION_MAX_TOKENS=1
LLM2DECISION_DISABLE_THINKING=true
LLM2DECISION_LOGIT_BIAS_ENABLED=false
LLM2DECISION_LOGIT_BIAS_STRENGTH=5.0
LLM2DECISION_TIMEOUT_SECONDS=60
LLM2DECISION_MAX_CONCURRENCY=8
LLM2DECISION_PROMPT_VERSION=v1
